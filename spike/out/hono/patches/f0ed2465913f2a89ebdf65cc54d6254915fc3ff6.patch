+    const q = explicit ? explicit.q : (wildcardQ ?? 0)
+    if (q === 1) {
+      return enc
+    } else if (q > 0 && (!best || q > best.q)) {
+      best = { encoding: enc, q }
+    }
+  }
+  return best?.encoding
+}
